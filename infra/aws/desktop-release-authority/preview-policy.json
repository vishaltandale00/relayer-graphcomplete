{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyMissingPreviewObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::relayer-desktop-updates-647746916062",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "desktop/macos/arm64/releases/*",
            "desktop/macos/arm64/beta-mac.yml",
            "desktop/macos/x64/releases/*",
            "desktop/macos/x64/beta-mac.yml",
            "desktop/windows/x64/releases/*",
            "desktop/windows/x64/beta.yml",
            "private/history/macos-arm64/beta/*",
            "private/history/macos-x64/beta/*",
            "private/history/windows-x64/beta/*",
            "private/receipts/macos-arm64/preview/*",
            "private/receipts/macos-x64/preview/*",
            "private/receipts/windows-x64/preview/*"
          ]
        }
      }
    },
    {
      "Sid": "PublishTargetPreviewObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/macos/arm64/releases/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/macos/arm64/beta-mac.yml",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/macos/x64/releases/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/macos/x64/beta-mac.yml",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/windows/x64/releases/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/windows/x64/beta.yml",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-arm64/beta/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-x64/beta/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/windows-x64/beta/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/receipts/macos-arm64/preview/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/receipts/macos-x64/preview/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/receipts/windows-x64/preview/*"
      ]
    }
  ]
}

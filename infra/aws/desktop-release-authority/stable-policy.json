{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IdentifyMissingStableObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::relayer-desktop-updates-647746916062",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "desktop/macos/arm64/releases/*",
            "desktop/macos/arm64/latest-mac.yml",
            "desktop/macos/x64/releases/*",
            "desktop/macos/x64/latest-mac.yml",
            "desktop/windows/x64/releases/*",
            "desktop/windows/x64/latest.yml",
            "private/history/macos-arm64/beta/*",
            "private/history/macos-arm64/latest/*",
            "private/history/macos-x64/beta/*",
            "private/history/macos-x64/latest/*",
            "private/history/windows-x64/beta/*",
            "private/history/windows-x64/latest/*",
            "private/receipts/macos-arm64/preview/*",
            "private/receipts/macos-arm64/stable/*",
            "private/receipts/macos-x64/preview/*",
            "private/receipts/macos-x64/stable/*",
            "private/receipts/windows-x64/preview/*",
            "private/receipts/windows-x64/stable/*"
          ]
        }
      }
    },
    {

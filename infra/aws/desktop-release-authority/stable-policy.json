        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-x64/latest/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/windows-x64/latest/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/receipts/macos-arm64/stable/*",

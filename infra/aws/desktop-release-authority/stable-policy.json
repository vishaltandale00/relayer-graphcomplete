        "arn:aws:s3:::relayer-desktop-updates-647746916062/desktop/windows/x64/latest.yml",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-arm64/beta/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-arm64/latest/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-x64/beta/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/macos-x64/latest/*",
        "arn:aws:s3:::relayer-desktop-updates-647746916062/private/history/windows-x64/beta/*",

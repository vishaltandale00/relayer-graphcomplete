{
  "name": "relayer-graphcomplete",
  "version": "0.0.0",
  "description": "Graph-native agent workspace with a harness- and provider-agnostic product contract.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "workspaces": [
    "desktop",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "files": [
    "dist",
    "harnesses",
    "python/relayer-graph"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:renderer": "node scripts/prepare-renderer-vendor.mjs",
    "prepare:desktop-runtime": "npm run prepare:renderer && npm run build:packages",
    "prebuild": "npm run prepare:renderer",
    "precheck": "npm run prepare:renderer",
    "pretest": "npm run prepare:renderer",
    "predesktop:pack": "npm run prepare:desktop-runtime",
    "predesktop:dist": "npm run prepare:desktop-runtime",
    "predesktop:dist:preview": "npm run prepare:desktop-runtime",
    "build": "node scripts/clean-dist.mjs && cargo build -p relayer-app-server -p relayer-graph-server && tsc -p tsconfig.build.json && npm run build:packages",
    "build:packages": "npm run build -w @relayer/graph-client && npm run build -w @relayer/visual-assets && npm run build -w @relayer/harness-host && npm run build -w @relayer/eval-runner",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace && npm run check:graph-crash-reconciliation && cargo build -p relayer-app-server -p relayer-graph-server && npm run build:packages && tsc --noEmit && npm run check --workspaces --if-present && vitest run && npm run test:codex-secret-boundary && PYTHONPATH=python/relayer-graph/src python3 -m unittest discover -s python/relayer-graph/tests && npm run lint:ladybug-receipt && npm run prd:check-readability",
    "check:graph-crash-reconciliation": "cargo test -p relayer-graph-core -p relayer-graph-server --features crash-test-support",
    "check:models": "node scripts/models/check-tla.mjs",
    "doctor:dev": "node scripts/doctor-dev.mjs",
    "test": "cargo build -p relayer-app-server -p relayer-graph-server && npm run build:packages && vitest run",
    "test:codex-secret-boundary": "RELAYER_RUN_CODEX_SECRET_BOUNDARY=1 vitest run packages/harness-host/test/codex-secret-provider-process.test.ts",
    "test:prime-managed-runtime": "node scripts/verify-prime-managed-runtime.mjs",
    "test:desktop:stop": "npm run build && electron scripts/test-desktop-stop.mjs",
    "test:desktop:interaction-graph-layout": "node scripts/test-interaction-graph-layout.mjs",
    "test:desktop:first-message": "npm run build && electron scripts/test-desktop-first-message.mjs",
    "test:desktop:artifact-viewer": "npm run build && electron scripts/test-desktop-artifact-viewer.mjs",
    "test:desktop:project-new-thread": "npm run build && node scripts/run-project-new-thread-test.mjs",
    "test:desktop:context-draft-warning": "npm run build && node scripts/run-context-draft-warning-test.mjs",
    "test:desktop:interaction-context": "npm run build && node scripts/run-interaction-context-lifecycle-test.mjs",
    "test:desktop:node-input-actions": "npm run build && node scripts/run-node-input-actions-test.mjs",
    "test:desktop:visual-node-details": "npm run build && node scripts/run-desktop-visual-node-details-test.mjs",
    "test:desktop:node-detail-csp": "npm run build && electron scripts/test-node-detail-csp.mjs",
    "evidence:model-selector": "RELAYER_CAPTURE_MODEL_SELECTOR_EVIDENCE=1 electron scripts/capture-model-selector-evidence.mjs",
    "evidence:provider-ux": "node scripts/capture-provider-ux-video.mjs",
    "evidence:prime-family:packaged": "node scripts/capture-packaged-prime-family-evidence.mjs",
    "evidence:ladybug-index-latency": "node scripts/capture-ladybug-index-latency.mjs",
    "evidence:human-eval-annotations": "npm run build && RELAYER_CAPTURE_HUMAN_ANNOTATION_EVIDENCE=1 electron scripts/capture-human-eval-annotation-evidence.mjs",
    "evidence:share-action-details": "RELAYER_CAPTURE_SHARE_ACTION_DETAILS=1 electron scripts/capture-share-action-details-evidence.mjs",
    "review:share-action-details": "node scripts/fixtures/share-action-details.mjs",
    "evidence:public-share-viewer": "RELAYER_CAPTURE_PUBLIC_SHARE_VIEWER_EVIDENCE=1 electron scripts/capture-public-share-viewer-evidence.mjs",
    "evidence:share-publish-restart": "node scripts/test-share-publish-restart.mjs",
    "prebuild:public-share-viewer-artifact": "npm run prepare:renderer",
    "build:public-share-viewer-artifact": "node scripts/build-public-share-viewer-artifact.mjs",
    "evidence:telemetry": "node scripts/run-telemetry-evidence.mjs",
    "test:desktop:approval": "npm run build && electron scripts/test-desktop-approval.mjs",
    "prd": "node docs/prd/server.mjs",
    "prd:check-readability": "node docs/prd/check-readability.mjs",
    "desktop:dev": "npm run build && electron desktop/main/index.mjs",
    "prototype:project-row-hover": "open desktop/renderer/project-row-hover.prototype.html",
    "predesktop:dev:prime": "npm run build",
    "desktop:dev:prime": "node scripts/run-prime-desktop.mjs",
    "eval-app:dev": "node desktop/eval-main/index.mjs",
    "live:recursive-complete": "npm run build && node scripts/run-recursive-live-run.mjs",
    "eval:input-roundtrip:live": "RELAYER_EVAL_AUTORUN_INPUT_ROUNDTRIP=1 node desktop/eval-main/index.mjs",
    "lint:ladybug-receipt": "cargo fmt --manifest-path docs/evidence/issue-261-ladybug-probe/Cargo.toml -- --check && rustfmt --edition 2021 --check docs/evidence/issue-261-ladybug-probe/source-build-probe/src/main.rs && node scripts/lint-ladybug-qualification-receipt.mjs && npm run lint:ladybug-native-receipt && npm run lint:ladybug-contract-probe",
    "lint:ladybug-native-receipt": "node scripts/verify-ladybug-native-receipts.mjs",
    "lint:ladybug-contract-probe": "node scripts/lint-ladybug-contract-probe.mjs",
    "ladybug:source": "node scripts/prepare-ladybug-source.mjs",
    "desktop:pack": "node desktop/packaging/build-development.mjs",
    "desktop:dist": "node desktop/release/build-release.mjs stable",
    "desktop:dist:preview": "node desktop/release/build-release.mjs preview",
    "desktop:release:verify": "node desktop/release/verify-artifacts.mjs",
    "desktop:release:audit-authority": "node scripts/audit-desktop-release-authority.mjs",
    "desktop:release:publish-preview": "node desktop/release/publish-preview.mjs",
    "desktop:release:promote-stable": "node desktop/release/promote-stable.mjs",
    "test:eval-web": "node scripts/test-eval-web.mjs",
    "test:eval-graph-preview": "node scripts/test-eval-graph-preview.mjs",
    "test:eval-compiled-runtime": "vitest run --config scripts/eval-compiled.vitest.config.mjs",
    "evidence:public-share-embed": "RELAYER_CAPTURE_PUBLIC_SHARE_EMBED_EVIDENCE=1 electron scripts/capture-public-share-embed-evidence.mjs",
    "review:public-share-embed": "node scripts/fixtures/public-share-embed.mjs",
    "test:desktop:sidebar-overflow": "electron scripts/test-sidebar-overflow.mjs",
    "test:desktop:updater-diagnostics": "electron scripts/test-updater-diagnostics.mjs",
    "test:desktop:narrow-sidebar": "npm run build && npm run test:desktop:sidebar-overflow && electron scripts/test-desktop-narrow-sidebar.mjs",
    "evidence:share-preview": "electron scripts/capture-share-preview-evidence.mjs",
    "evidence:marine-icons": "npm run build && electron scripts/evidence-marine-icons.mjs",
    "test:desktop:worktrees": "npm run build && node scripts/run-worktree-test.mjs",
    "evidence:edge-shapes": "RELAYER_CAPTURE_EDGE_SHAPE_EVIDENCE=1 electron scripts/capture-edge-shape-evidence.mjs",
    "evidence:agent-preview": "electron scripts/capture-agent-preview-evidence.mjs",
    "evidence:agent-preview:live": "node scripts/run-agent-preview-live.mjs",
    "evidence:thread-archive": "electron scripts/capture-thread-archive-evidence.mjs",
    "desktop:dev:windows": "node scripts/run-windows-dev-loop.mjs",
    "desktop:status:windows": "node scripts/windows-dev-status.mjs",
    "desktop:sync:windows": "node scripts/windows-dev-sync.mjs",
    "desktop:qualify:windows-install": "node desktop/release/windows-first-install.mjs"
  },
  "devDependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "@electron/asar": "3.4.1",
    "@sentry/cli": "3.7.0",
    "@types/node": "^22.20.1",
    "app-builder-lib": "26.15.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "happy-dom": "20.0.8",
    "playwright": "1.58.2",
    "rolldown": "1.2.3",
    "tar": "7.5.22",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9",
    "yaml": "2.9.0",
    "extract-zip": "2.0.1"
  }
}
